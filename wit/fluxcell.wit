package spectragql:fluxcell@0.1.0;

interface types {
    enum http-method {
        get,
        post,
        put,
        delete,
        options,
    }

    record http-route {
        method: http-method,
        path: string,          /// Relative path, e.g. "/verify", "/status", "/send"
        description: string,
        timeout-ms: option<u64>,
    }

    record http-request {
        method: http-method,
        path: string,          /// Relative path within fluxcell namespace
        query-params: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record event-context {
        event-id: string,
        hlc: string,
        topic: string,
        payload-json: string,
    }

    enum event-verdict {
        ack,
        nack,
        dead-letter,
    }

    record fluxcell-metadata {
        version: string,
        git-hash: string,
        build-time: string,
    }
}

world fluxcell-guest {
    import types;

    /// Host capabilities imported by guest
    import kv-store: interface {
        get: func(key: string) -> option<string>;
        set: func(key: string, value: string, ttl-seconds: u64) -> bool;
        delete: func(key: string) -> bool;
    };

    import host-broker: interface {
        publish: func(topic: string, payload-json: string) -> bool;
    };

    import host-db: interface {
        /// Begin an isolated transaction on the specified database (or "" for default).
        /// Returns a monotonic transaction handle ID.
        begin-tx: func(db-name: string) -> result<u64, string>;

        /// Execute a mutating SQL statement (INSERT, UPDATE, DELETE) inside an active transaction.
        execute: func(tx-id: u64, sql: string, params-json: string) -> result<u64, string>;

        /// Execute a query (SELECT) inside an active transaction, returning rows as a JSON array string.
        query: func(tx-id: u64, sql: string, params-json: string) -> result<string, string>;

        /// Commit an active transaction.
        commit-tx: func(tx-id: u64) -> result<_, string>;

        /// Rollback an active transaction.
        rollback-tx: func(tx-id: u64) -> result<_, string>;
    };

    /// Guest declarations exported to host
    export get-subscriptions: func() -> list<string>;
    export get-routes: func() -> list<types.http-route>;
    export get-metadata: func() -> types.fluxcell-metadata;
    export get-config: func() -> string;

    /// Runtime execution handlers
    export handle-event: func(event: types.event-context) -> types.event-verdict;
    export handle-http: func(req: types.http-request) -> types.http-response;
}
