{
  "name": "fluxcell-seed-ts",
  "version": "0.1.0",
  "description": "Canonical barebones TypeScript starter seed for SpectraFlux WebAssembly Fluxcells",
  "type": "module",
  "scripts": {
    "build": "bun run ../../sdks/typescript/bin/build.mjs",
    "build:debug": "bun run ../../sdks/typescript/bin/build.mjs --debug",
    "test": "bun run ../../sdks/typescript/bin/verify-abi.mjs",
    "deploy": "bun run ../../sdks/typescript/bin/deploy.mjs",
    "status": "bun run ../../sdks/typescript/bin/deploy.mjs --status",
    "lockdown": "bun run ../../sdks/typescript/bin/deploy.mjs --lockdown"
  },
  "dependencies": {
    "@spectraflux/sdk": "file:../../sdks/typescript"
  },
  "devDependencies": {
    "assemblyscript": "^0.27.34"
  }
}
